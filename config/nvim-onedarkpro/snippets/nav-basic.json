{
	"Navbar with 3 column": {
	"prefix": "nav-basic",
	"body": [
		"<nav>",
		"    <div class=\"column-one\">",
		"        Icono chulo",
		"    </div>",
		"    <div class=\"column-two\">",
		"        <a href=\"#\">Inicio</a>",
		"        <a href=\"\">About</a>",
		"    </div>",
		"    <div class=\"column-three\">",
		"        <a href=\"\">Iniciar sesión</a>",
		"        <a href=\"\">Cerrar sesión</a>",
		"    </div>",
		"</nav>",
		"",
		"<style>",
		"    nav {",
		"        display: flex;",
		"        justify-content: space-between;",
		"        padding: 1em;",
		"        background-color: #000;",
		"        color: #fff;",
		"",
		"        & a {",
		"            text-decoration: none;",
		"            color: #fff;",
		"",
		"            &:hover {",
		"                color: aqua;",
		"            }",
		"        }",
		"        & div {",
		"            display: flex;",
		"            justify-content: space-between;",
		"        }",
		"        & .column-two, .column-one, .column-three {",
		"            gap: 23px;",
		"        }",
		"    }",
		"</style>"
	],
	"scope": "astro,html",
	"include": ["**/*.astro", "*.html"],
	"description": "Navbar with 3 column"
	}
}
